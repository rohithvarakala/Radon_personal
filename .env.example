# Root .env — loaded by Python scripts via python-dotenv
# Copy this file to .env and fill in your credentials

# Alpaca Markets (free paper trading — sign up at https://alpaca.markets)
ALPACA_API_KEY=your-alpaca-key
ALPACA_SECRET_KEY=your-alpaca-secret
# Use paper URL for practice, live URL for real trading
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# MenthorQ (optional — CTA positioning data)
# MENTHORQ_USER=your-menthorq-email
# MENTHORQ_PASS=your-menthorq-password
