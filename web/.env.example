# Web .env — loaded by Next.js built-in env handling
# Copy this file to web/.env and fill in your credentials

# Anthropic Claude API (required — AI chat + vision features)
ANTHROPIC_API_KEY=your-anthropic-key

# Unusual Whales (required — dark pool flow, options flow, analyst data)
UW_TOKEN=your-unusual-whales-key

# Exa (recommended — company/market research)
EXA_API_KEY=your-exa-key

# Cerebras (optional)
# CEREBRAS_API_KEY=your-cerebras-key
